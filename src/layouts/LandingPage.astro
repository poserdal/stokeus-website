---
interface Props {
  frontmatter: {
    title: string;
    metaDescription: string;
    searchHeadline: string;
    searchHeadlineEm?: string;
    searchSubhead: string;
    category: string;
    readTime: string;
    bridgeHeadline: string;
    bridgeHeadlineEm?: string;
    bridgeBody: string;
    relatedArticles: Array<{
      tag: string;
      title: string;
      slug: string;
    }>;
    publishedDate?: Date;
  };
  faqItems?: Array<{
    question: string;
    answer: string;
  }>;
}

const { frontmatter, faqItems } = Astro.props;
const APP_STORE_URL = 'https://apps.apple.com/us/app/stoke-for-couples/id6753605202';
const canonicalUrl = `https://stokeus.com/${Astro.params.slug}`;
const publishedDateISO = frontmatter.publishedDate ? frontmatter.publishedDate.toISOString().split('T')[0] : undefined;

// Build Article schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title.replace(' · Stoke', ''),
  "description": frontmatter.metaDescription,
  "author": {
    "@type": "Organization",
    "name": "Stoke",
    "url": "https://stokeus.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Stoke",
    "url": "https://stokeus.com"
  },
  "mainEntityOfPage": canonicalUrl,
  ...(publishedDateISO && { "datePublished": publishedDateISO }),
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".article h2", ".article p:first-of-type"]
  }
};

// Build FAQ schema if faqItems provided
const faqSchema = faqItems && faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{frontmatter.title}</title>
<meta name="description" content={frontmatter.metaDescription}>
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph -->
<meta property="og:title" content={frontmatter.title} />
<meta property="og:description" content={frontmatter.metaDescription} />
<meta property="og:type" content="article" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Stoke" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={frontmatter.title} />
<meta name="twitter:description" content={frontmatter.metaDescription} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #F5F0E8;
    --cream-dark: #EDE8DF;
    --cream-darker: #E0D9CE;
    --black: #1A1A1A;
    --black-soft: #2C2C2C;
    --gray: #5C5C5C;
    --gray-light: #9A9A9A;
    --flame: #FF6B35;
    --flame-dark: #E5521A;
    --border: #D9D4CB;
    --max-width: 720px;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--black);
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    line-height: 1.6;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: 0.35;
  }

  .sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--black);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 100;
    transform: translateY(100%);
    animation: slideUp 0.5s 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes slideUp {
    to { transform: translateY(0); }
  }

  .sticky-bar p {
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    font-weight: 400;
  }
  .sticky-bar strong {
    color: white;
    display: block;
    font-size: 15px;
    font-weight: 500;
  }

  .sticky-download {
    background: var(--flame);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 100px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .sticky-download:hover { background: var(--flame-dark); }

  nav {
    padding: 28px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    opacity: 0;
    animation: fadeIn 0.6s 0.1s ease forwards;
  }

  @media (max-width: 600px) {
    nav { padding: 20px 24px; }
  }

  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--black);
    text-decoration: none;
  }

  .nav-cta {
    background: var(--black);
    color: white;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.2s, transform 0.15s;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-cta:hover { background: var(--black-soft); transform: translateY(-1px); }

  .hero {
    padding: 60px 48px 48px;
    max-width: var(--max-width);
    margin: 0 auto;
    opacity: 0;
    animation: fadeIn 0.8s 0.2s ease forwards;
  }

  @media (max-width: 600px) {
    .hero { padding: 40px 24px 36px; }
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .category-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--cream-dark);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--flame);
  }

  .meta-dot { color: var(--gray-light); font-size: 12px; }

  .read-time {
    font-size: 12px;
    color: var(--gray-light);
    font-weight: 400;
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 6vw, 52px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--black);
    margin-bottom: 20px;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--flame);
  }

  .hero-sub {
    font-size: clamp(16px, 2vw, 18px);
    color: var(--gray);
    line-height: 1.75;
    font-weight: 300;
  }

  .hero-sub strong {
    color: var(--black);
    font-weight: 500;
  }

  .app-store-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--black);
    color: white;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 14px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(26,26,26,0.2);
  }

  .app-store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(26,26,26,0.25);
  }

  .app-store-btn svg { flex-shrink: 0; }

  .app-store-text { text-align: left; line-height: 1.2; }
  .app-store-text span { display: block; font-size: 11px; font-weight: 400; color: rgba(255,255,255,0.7); letter-spacing: 0.02em; }
  .app-store-text strong { display: block; font-size: 18px; font-weight: 600; color: white; }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .article {
    padding: 60px 48px;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  @media (max-width: 600px) { .article { padding: 48px 24px; } }

  .article :global(h2) {
    font-family: 'Playfair Display', serif;
    font-size: clamp(24px, 3.5vw, 32px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 24px;
  }

  .article :global(h3) {
    font-family: 'Playfair Display', serif;
    font-size: clamp(18px, 2.5vw, 22px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--black);
    margin: 40px 0 16px;
  }

  .article :global(p) {
    font-size: clamp(16px, 1.8vw, 17px);
    color: var(--gray);
    line-height: 1.8;
    margin-bottom: 20px;
    font-weight: 300;
  }

  .article :global(p strong) {
    color: var(--black);
    font-weight: 500;
  }

  .article :global(p em) {
    font-style: italic;
    color: var(--flame);
    font-weight: 400;
  }

  .article :global(blockquote) {
    border-left: 3px solid var(--flame);
    padding: 4px 0 4px 24px;
    margin: 36px 0;
    font-family: 'Playfair Display', serif;
    font-size: clamp(18px, 2.2vw, 20px);
    font-style: italic;
    color: var(--black);
    font-weight: 700;
    line-height: 1.5;
  }

  .article :global(blockquote p) {
    font-family: 'Playfair Display', serif;
    font-size: clamp(18px, 2.2vw, 20px);
    font-style: italic;
    color: var(--black);
    font-weight: 700;
    line-height: 1.5;
    margin: 0;
  }

  .bridge {
    background: var(--cream-dark);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 80px 48px;
  }
  @media (max-width: 600px) { .bridge { padding: 60px 24px; } }

  .bridge-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--flame);
    margin-bottom: 20px;
  }

  .bridge h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 24px;
  }

  .bridge h2 em { font-style: italic; color: var(--flame); }

  .bridge p {
    font-size: clamp(16px, 1.8vw, 17px);
    color: var(--gray);
    line-height: 1.8;
    margin-bottom: 20px;
    font-weight: 300;
  }

  .bridge p strong { color: var(--black); font-weight: 500; }
  .bridge p em { font-style: italic; color: var(--flame); }

  .bridge .app-store-btn {
    margin-top: 12px;
  }

  .closing {
    padding: 100px 48px 160px;
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }
  @media (max-width: 600px) { .closing { padding: 80px 24px 140px; } }

  .closing h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--black);
    margin-bottom: 20px;
  }

  .closing h2 em { font-style: italic; color: var(--flame); }

  .closing-sub {
    font-size: 18px;
    color: var(--gray);
    margin-bottom: 48px;
    font-weight: 300;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.65;
  }

  .closing-btn-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .closing-note {
    font-size: 13px;
    color: var(--gray-light);
  }

  .related {
    background: var(--black);
    padding: 80px 48px;
  }
  @media (max-width: 600px) { .related { padding: 60px 24px; } }

  .related-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .related-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--flame);
    margin-bottom: 32px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 768px) { .related-grid { grid-template-columns: 1fr; } }

  .related-card {
    background: rgba(255,255,255,0.04);
    padding: 28px;
    border: 1px solid rgba(255,255,255,0.07);
    transition: background 0.2s;
    text-decoration: none;
    display: block;
  }

  .related-card:hover { background: rgba(255,255,255,0.07); }

  .related-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--flame);
    margin-bottom: 12px;
    display: block;
  }

  .related-title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 700;
    color: white;
    line-height: 1.35;
  }

  footer {
    padding: 40px 48px 100px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  @media (max-width: 600px) { footer { padding: 32px 24px 100px; } }

  .footer-logo {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 900;
    color: var(--black);
    text-decoration: none;
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--gray-light);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--black);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
</head>
<body>

<!-- STICKY DOWNLOAD BAR -->
<div class="sticky-bar">
  <div>
    <strong>Download Stoke</strong>
    <p>Free to start. Available on iOS.</p>
  </div>
  <a href={APP_STORE_URL} class="sticky-download" target="_blank">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
    Download Free
  </a>
</div>

<!-- NAV -->
<nav>
  <a href="/" class="nav-logo">STOKE</a>
  <a href={APP_STORE_URL} class="nav-cta" target="_blank">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
    Get the App
  </a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-meta">
    <span class="category-tag">{frontmatter.category}</span>
    <span class="meta-dot">&middot;</span>
    <span class="read-time">{frontmatter.readTime}</span>
  </div>

  <h1>
    {frontmatter.searchHeadline}
    {frontmatter.searchHeadlineEm && <> <em>{frontmatter.searchHeadlineEm}</em></>}
  </h1>

  <p class="hero-sub" set:html={frontmatter.searchSubhead} />
</section>

<hr class="divider">

<!-- ARTICLE -->
<section class="article reveal">
  <slot />
</section>

<hr class="divider">

<!-- WHERE STOKE COMES IN -->
<section class="bridge reveal">
  <div class="bridge-inner">
    <p class="section-label">Where Stoke comes in</p>

    <h2>
      {frontmatter.bridgeHeadline}
      {frontmatter.bridgeHeadlineEm && <> <em>{frontmatter.bridgeHeadlineEm}</em></>}
    </h2>

    <p set:html={frontmatter.bridgeBody} />

    <a href={APP_STORE_URL} class="app-store-btn" target="_blank">
      <svg width="28" height="34" viewBox="0 0 814 1000" fill="white">
        <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-37.3-167.8-107.8c-73.5-83-132.7-223.6-132.7-357.8 0-197.4 129.5-301.5 257.4-301.5 71.9 0 131.8 47.3 176.9 47.3 43.2 0 110.7-50.2 188.7-50.2 30.3 0 128.1 2.6 194.7 98.5zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/>
      </svg>
      <div class="app-store-text">
        <span>Download on the</span>
        <strong>App Store</strong>
      </div>
    </a>
  </div>
</section>

<!-- CLOSING CTA -->
<section class="closing reveal">
  <h2>The best relationships aren't <em>lucky.</em><br>They're intentional.</h2>
  <p class="closing-sub">Love isn't just one thing. It's everything you choose to do with the person in front of you, every single day.</p>

  <div class="closing-btn-wrap">
    <a href={APP_STORE_URL} class="app-store-btn" target="_blank">
      <svg width="28" height="34" viewBox="0 0 814 1000" fill="white">
        <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-37.3-167.8-107.8c-73.5-83-132.7-223.6-132.7-357.8 0-197.4 129.5-301.5 257.4-301.5 71.9 0 131.8 47.3 176.9 47.3 43.2 0 110.7-50.2 188.7-50.2 30.3 0 128.1 2.6 194.7 98.5zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/>
      </svg>
      <div class="app-store-text">
        <span>Download on the</span>
        <strong>App Store</strong>
      </div>
    </a>
    <p class="closing-note">Free to start &middot; iOS &middot; No credit card required</p>
  </div>
</section>

<!-- RELATED ARTICLES -->
{frontmatter.relatedArticles && frontmatter.relatedArticles.length > 0 && (
  <section class="related reveal">
    <div class="related-inner">
      <p class="related-label">Keep reading</p>
      <div class="related-grid">
        {frontmatter.relatedArticles.map((article) => (
          <a href={`/${article.slug}`} class="related-card">
            <span class="related-tag">{article.tag}</span>
            <span class="related-title">{article.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

