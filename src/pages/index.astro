<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stoke — Ignite Your Relationship</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #F5F0E8;
    --cream-dark: #EDE8DF;
    --cream-darker: #E0D9CE;
    --black: #1A1A1A;
    --black-soft: #2C2C2C;
    --gray: #5C5C5C;
    --gray-light: #9A9A9A;
    --flame: #FF6B35;
    --flame-dark: #E5521A;
    --border: #D9D4CB;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--black);
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ─── NOISE TEXTURE OVERLAY ─── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: 0.35;
  }

  /* ─── STICKY DOWNLOAD BAR ─── */
  .sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--black);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 100;
    transform: translateY(100%);
    animation: slideUp 0.5s 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes slideUp {
    to { transform: translateY(0); }
  }

  .sticky-bar p {
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    font-weight: 400;
  }
  .sticky-bar strong {
    color: white;
    display: block;
    font-size: 15px;
    font-weight: 500;
  }

  .sticky-download {
    background: var(--flame);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 100px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .sticky-download:hover { background: var(--flame-dark); }

  /* ─── NAV ─── */
  nav {
    padding: 28px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    opacity: 0;
    animation: fadeIn 0.6s 0.1s ease forwards;
  }

  @media (max-width: 600px) {
    nav { padding: 20px 24px; }
  }

  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--black);
    text-decoration: none;
  }

  .nav-cta {
    background: var(--black);
    color: white;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.2s, transform 0.15s;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-cta:hover { background: var(--black-soft); transform: translateY(-1px); }

  /* ─── HERO ─── */
  .hero {
    padding: 60px 48px 80px;
    max-width: 960px;
    margin: 0 auto;
    opacity: 0;
    animation: fadeIn 0.8s 0.2s ease forwards;
  }

  @media (max-width: 600px) {
    .hero { padding: 40px 24px 60px; }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--cream-dark);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 32px;
  }

  .hero-eyebrow .dot {
    width: 6px;
    height: 6px;
    background: var(--flame);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(48px, 8vw, 88px);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--black);
    margin-bottom: 12px;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--flame);
  }

  .hero-sub {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 700;
    line-height: 1.35;
    color: var(--black);
    margin-bottom: 28px;
    max-width: 620px;
  }

  .hero-body {
    font-size: clamp(16px, 1.8vw, 18px);
    color: var(--gray);
    max-width: 580px;
    margin-bottom: 40px;
    line-height: 1.75;
  }

  .hero-body strong {
    color: var(--black);
    font-weight: 500;
  }

  /* ─── APP STORE BUTTON ─── */
  .app-store-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--black);
    color: white;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 14px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(26,26,26,0.2);
  }

  .app-store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(26,26,26,0.25);
  }

  .app-store-btn svg { flex-shrink: 0; }

  .app-store-text { text-align: left; line-height: 1.2; }
  .app-store-text span { display: block; font-size: 11px; font-weight: 400; color: rgba(255,255,255,0.7); letter-spacing: 0.02em; }
  .app-store-text strong { display: block; font-size: 18px; font-weight: 600; color: white; }

  .hero-footnote {
    margin-top: 16px;
    font-size: 13px;
    color: var(--gray-light);
  }

  /* ─── DIVIDER ─── */
  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0 48px;
    opacity: 0;
    animation: fadeIn 0.6s 0.6s ease forwards;
  }
  @media (max-width: 600px) { .divider { margin: 0 24px; } }

  /* ─── BODY COPY SECTION ─── */
  .section {
    padding: 80px 48px;
    max-width: 960px;
    margin: 0 auto;
  }
  @media (max-width: 600px) { .section { padding: 60px 24px; } }

  .body-copy {
    font-family: 'Playfair Display', serif;
    font-size: clamp(22px, 3.5vw, 32px);
    font-weight: 700;
    line-height: 1.45;
    color: var(--black);
    max-width: 760px;
    margin-bottom: 32px;
  }

  .body-copy em {
    font-style: italic;
    color: var(--flame);
  }

  .body-para {
    font-size: clamp(16px, 1.8vw, 18px);
    color: var(--gray);
    max-width: 620px;
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .body-para strong {
    color: var(--black);
    font-weight: 500;
  }

  /* ─── OUTCOMES ─── */
  .outcomes-section {
    background: var(--black);
    padding: 80px 48px;
    margin: 0;
  }
  @media (max-width: 600px) { .outcomes-section { padding: 60px 24px; } }

  .outcomes-inner { max-width: 960px; margin: 0 auto; }

  .outcomes-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--flame);
    margin-bottom: 20px;
  }

  .outcomes-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 56px;
    max-width: 600px;
  }

  .outcomes-headline em { font-style: italic; color: var(--flame); }

  .outcomes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
  }

  @media (max-width: 640px) { .outcomes-grid { grid-template-columns: 1fr; } }

  .outcome-card {
    background: rgba(255,255,255,0.04);
    padding: 36px;
    border: 1px solid rgba(255,255,255,0.07);
    transition: background 0.2s;
  }

  .outcome-card:hover { background: rgba(255,255,255,0.07); }

  .outcome-number {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 900;
    color: var(--flame);
    opacity: 0.3;
    line-height: 1;
    margin-bottom: 16px;
  }

  .outcome-title {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: white;
    margin-bottom: 12px;
    line-height: 1.25;
  }

  .outcome-body {
    font-size: 15px;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    font-weight: 300;
  }

  /* ─── HOW IT WORKS ─── */
  .how-section { padding: 80px 48px; max-width: 960px; margin: 0 auto; }
  @media (max-width: 600px) { .how-section { padding: 60px 24px; } }

  .section-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--flame);
    margin-bottom: 20px;
  }

  .section-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 56px;
    max-width: 500px;
  }

  .steps { display: flex; flex-direction: column; gap: 0; }

  .step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    padding: 40px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .step:first-child { border-top: 1px solid var(--border); }

  .step-num {
    font-family: 'Playfair Display', serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--gray-light);
    letter-spacing: 0.04em;
    padding-top: 4px;
  }

  .step-content {}

  .step-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--black);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .step-body {
    font-size: 16px;
    color: var(--gray);
    line-height: 1.7;
    max-width: 500px;
  }

  /* ─── SOCIAL PROOF ─── */
  .proof-section {
    background: var(--cream-dark);
    padding: 80px 48px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 600px) { .proof-section { padding: 60px 24px; } }

  .proof-inner { max-width: 960px; margin: 0 auto; }

  .proof-quotes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (max-width: 840px) { .proof-quotes { grid-template-columns: 1fr; } }

  .quote-card {
    background: var(--cream);
    border: 1px solid var(--border);
    padding: 32px;
    border-radius: 4px;
  }

  .quote-mark {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    line-height: 1;
    color: var(--flame);
    margin-bottom: 12px;
    opacity: 0.6;
  }

  .quote-text {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-style: italic;
    color: var(--black);
    line-height: 1.6;
    margin-bottom: 20px;
    font-weight: 700;
  }

  .quote-attr {
    font-size: 13px;
    color: var(--gray-light);
    font-weight: 400;
  }

  /* ─── CLOSING CTA ─── */
  .closing-section {
    padding: 100px 48px 160px;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }
  @media (max-width: 600px) { .closing-section { padding: 80px 24px 140px; } }

  .closing-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 58px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--black);
    margin-bottom: 20px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .closing-headline em { font-style: italic; color: var(--flame); }

  .closing-sub {
    font-size: 18px;
    color: var(--gray);
    margin-bottom: 48px;
    font-weight: 300;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.65;
  }

  .closing-btn-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .closing-note {
    font-size: 13px;
    color: var(--gray-light);
  }

  /* ─── DEFINITION BAR ─── */
  .definition-bar {
    text-align: center;
    padding: 12px 24px;
    background: var(--cream-dark);
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    color: var(--gray);
    letter-spacing: 0.01em;
  }
  .definition-bar strong { color: var(--black); font-weight: 600; }

  /* ─── FOOTER ─── */
  footer {
    padding: 40px 48px 100px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  @media (max-width: 600px) { footer { padding: 32px 24px 100px; } }

  .footer-logo {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 900;
    color: var(--black);
  }

  .footer-note {
    font-size: 13px;
    color: var(--gray-light);
  }

  .footer-note a {
    color: inherit;
  }

  /* ─── UTILS ─── */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── FLAME ACCENT LINE ─── */
  .accent-line {
    width: 40px;
    height: 3px;
    background: var(--flame);
    margin-bottom: 32px;
    border-radius: 2px;
  }
</style>
</head>
